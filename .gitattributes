# Normalize line endings — LF in the repo, native on checkout.
* text=auto

# Source: always LF
*.js  text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.sh  text eol=lf

# Windows: keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.zip binary
*.exe binary
*.dll binary
